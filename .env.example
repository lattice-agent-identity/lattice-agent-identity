APP_HOST=launch.example.com
WORKSTATIONS_HOST=workspace.example.com
IDENTITY_HOST=id.example.com
IDENTITY_ADMIN_HOST=identity-admin.example.com
IDENTITY_DB_PASSWORD=replace-with-64-random-hex-characters
WORKSTATIONS_DB_PASSWORD=replace-with-64-random-hex-characters
WORKSTATIONS_OIDC_CLIENT_ID=replace-with-identity-traditional-client-id
WORKSTATIONS_OIDC_CLIENT_SECRET=replace-with-client-secret
OIDC_CLIENT_ID=replace-with-launcher-traditional-client-id
OIDC_CLIENT_SECRET=replace-with-launcher-client-secret
IDENTITY_MANAGEMENT_CLIENT_ID=replace-with-management-m2m-client-id
IDENTITY_MANAGEMENT_CLIENT_SECRET=replace-with-management-m2m-client-secret
IDENTITY_MANAGEMENT_RESOURCE=https://default.logto.app/api
WORKSTATIONS_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
WORKSTATIONS_TEMPLATE_ID=00000000-0000-0000-0000-000000000002
LAUNCH_CONTROLLERS={"replace-identity-sub":"00000000-0000-0000-0000-000000000003"}
WORKSTATIONS_ADMIN_TOKEN_PATH=./.local/secrets/workstations-admin-token
PROVISIONER_KEY_PATH=./.local/secrets/provisioner-key
WORKSPACE_DOCKER_SOCKET=/run/user/1000/docker.sock
MAX_WORKSPACES_PER_CONTROLLER=3
